# Copy to .env (or export directly) and fill in what you need.
# Never commit a real .env; only .env.example is tracked.

# Hosted provider API keys: only needed for agents whose card sets that provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Ollama endpoint. Defaults to a local instance (http://localhost:11434).
# To run this app on your own machine while the LLM calls run on a remote
# server (recommended: LLM load stays off your machine, everything else
# stays fast locally), point this at the remote host instead:
#   OLLAMA_BASE_URL=http://<remote-host>:11434
OLLAMA_BASE_URL=http://localhost:11434

# Per-request timeout for Ollama calls, in seconds. Raised from the
# requests-library default of 300s because switching between several
# distinct models in one survey makes Ollama cold-load each one, and a
# reasoning model (deepseek-r1) can take a while on chain-of-thought.
# See docs/development/diagnostics.md.
OLLAMA_TIMEOUT_SECONDS=900

# Backing services for the web_search tool (symphysis.tools.web_search):
# SearXNG for discovery, Crawl4AI for extraction. No API key needed for
# either. Defaults assume both run as sibling services on this app's own
# Docker Compose network (see docker-compose.yml); override here only if
# running them elsewhere.
# SEARXNG_BASE_URL=http://searxng:8080
# CRAWL4AI_BASE_URL=http://crawl4ai:11235
