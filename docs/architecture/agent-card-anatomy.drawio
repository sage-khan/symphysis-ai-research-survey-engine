        <mxCell id="title" value="Agent Card: portable JSON spec for one spawnable agent" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#cdd6f4;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1360" height="30" as="geometry"/></mxCell><mxCell id="subtitle" value="One JSON file per agent. Given the same JSON and shared DID seed, an identical agent can be respawned anywhere." style="text;html=1;fontSize=12;fontColor=#a6adc8;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1360" height="24" as="geometry"/></mxCell><mxCell id="cat0" value="&lt;b&gt;Identity&lt;/b&gt;&lt;br&gt;&lt;br&gt;&#8226; agent_id&lt;br&gt;&#8226; display_name&lt;br&gt;&#8226; expertise&lt;br&gt;&#8226; role, role_description" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#313244;strokeColor=#89b4fa;fontColor=#cdd6f4;fontSize=12;align=left;spacingLeft=10;spacingTop=8;verticalAlign=top;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="420" height="170" as="geometry"/></mxCell><mxCell id="cat1" value="&lt;b&gt;Decentralized Identity&lt;/b&gt;&lt;br&gt;&lt;br&gt;&#8226; did:key method&lt;br&gt;&#8226; public_key_multibase&lt;br&gt;&#8226; deterministic + seed_derivation
(no raw seed stored)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#313244;strokeColor=#89b4fa;fontColor=#cdd6f4;fontSize=12;align=left;spacingLeft=10;spacingTop=8;verticalAlign=top;arcSize=8;" vertex="1" parent="1"><mxGeometry x="510" y="90" width="420" height="170" as="geometry"/></mxCell><mxCell id="cat2" value="&lt;b&gt;Model&lt;/b&gt;&lt;br&gt;&lt;br&gt;&#8226; provider, name&lt;br&gt;&#8226; temperature, max_tokens, top_p, seed&lt;br&gt;&#8226; optional model_hash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#313244;strokeColor=#89b4fa;fontColor=#cdd6f4;fontSize=12;align=left;spacingLeft=10;spacingTop=8;verticalAlign=top;arcSize=8;" vertex="1" parent="1"><mxGeometry x="980" y="90" width="420" height="170" as="geometry"/></mxCell><mxCell id="cat3" value="&lt;b&gt;Grounding&lt;/b&gt;&lt;br&gt;&lt;br&gt;&#8226; rag: enabled, corpus_path, top_k,
embedding_model, chunk_size/overlap&lt;br&gt;&#8226; role_pack: standard knowledge pack id&lt;br&gt;&#8226; tools: e.g. web_search" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#313244;strokeColor=#89b4fa;fontColor=#cdd6f4;fontSize=12;align=left;spacingLeft=10;spacingTop=8;verticalAlign=top;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="420" height="170" as="geometry"/></mxCell><mxCell id="cat4" value="&lt;b&gt;Sampling&lt;/b&gt;&lt;br&gt;&lt;br&gt;&#8226; repeats (independent samples)&lt;br&gt;&#8226; max_retries_on_malformed&lt;br&gt;&#8226; agreement_threshold" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#313244;strokeColor=#89b4fa;fontColor=#cdd6f4;fontSize=12;align=left;spacingLeft=10;spacingTop=8;verticalAlign=top;arcSize=8;" vertex="1" parent="1"><mxGeometry x="510" y="300" width="420" height="170" as="geometry"/></mxCell><mxCell id="cat5" value="&lt;b&gt;Permissions&lt;/b&gt;&lt;br&gt;&lt;br&gt;&#8226; data_scopes (glob patterns)&lt;br&gt;&#8226; allowed_providers&lt;br&gt;&#8226; max_cost_usd" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#313244;strokeColor=#89b4fa;fontColor=#cdd6f4;fontSize=12;align=left;spacingLeft=10;spacingTop=8;verticalAlign=top;arcSize=8;" vertex="1" parent="1"><mxGeometry x="980" y="300" width="420" height="170" as="geometry"/></mxCell><mxCell id="cat6" value="&lt;b&gt;Guardrails&lt;/b&gt;&lt;br&gt;&lt;br&gt;&#8226; schema_validation&lt;br&gt;&#8226; denylist_patterns (regex)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#313244;strokeColor=#89b4fa;fontColor=#cdd6f4;fontSize=12;align=left;spacingLeft=10;spacingTop=8;verticalAlign=top;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="420" height="170" as="geometry"/></mxCell><mxCell id="cat7" value="&lt;b&gt;Behavior&lt;/b&gt;&lt;br&gt;&lt;br&gt;&#8226; system_prompt_template or
system_prompt_override&lt;br&gt;&#8226; rulefile (agent-specific rules)&lt;br&gt;&#8226; instrument (e.g. bwm)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#313244;strokeColor=#89b4fa;fontColor=#cdd6f4;fontSize=12;align=left;spacingLeft=10;spacingTop=8;verticalAlign=top;arcSize=8;" vertex="1" parent="1"><mxGeometry x="510" y="510" width="420" height="170" as="geometry"/></mxCell><mxCell id="cat8" value="&lt;b&gt;Environment&lt;/b&gt;&lt;br&gt;&lt;br&gt;&#8226; runtime + runtime_version&lt;br&gt;&#8226; python_version, platform&lt;br&gt;&#8226; container_image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#313244;strokeColor=#89b4fa;fontColor=#cdd6f4;fontSize=12;align=left;spacingLeft=10;spacingTop=8;verticalAlign=top;arcSize=8;" vertex="1" parent="1"><mxGeometry x="980" y="510" width="420" height="170" as="geometry"/></mxCell>
