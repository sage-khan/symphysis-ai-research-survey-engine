# Dependencies
.venv/
venv/
__pycache__/
*.pyc
*.pyo

# Test/build artifacts
.pytest_cache/
*.egg-info/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
/dist/
/build/

# Environment files
.env
.env.local
.env.*.local

# IDE & OS
.vscode/
.idea/
*.iml
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# draw.io desktop app's own lock/backup files for an open .drawio file,
# not source content.
.$*.drawio.bkp

# Runtime survey output (conversation logs, DIDs, reports) is real,
# generated-per-run data, not source; keep the example survey's *configs*
# tracked but not the per-agent runtime folders it produces.
surveys/*/agents/*/conversation.jsonl
surveys/*/agents/*/samples/
surveys/*/agents/*/did.json
surveys/*/agents/*/card.json
surveys/*/agents/*/result.json
surveys/*/agents/*/thoughts.md
surveys/*/agents/*/prompt.md
surveys/*/agents/*/filled_survey.md
surveys/*/agents/*/manual_input/
surveys/*/report/

# Web UI (web/backend/__pycache__/ is already covered by the blanket
# __pycache__/ rule above; no need to repeat it per-subdirectory)
web/frontend/node_modules/
web/frontend/dist/
web/frontend/.vite/
web/backend/data/*.json

# Scratch/temp working files
tmp/
